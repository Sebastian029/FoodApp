# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time; restart `npm start` after changes.
#
#   Browser on the same PC : http://localhost:8000/api
#   Android emulator       : http://10.0.2.2:8000/api
#   Phone (Expo Go)        : http://<your-LAN-IP>:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
