# Copy to .env and fill in the values.

# Django
SECRET_KEY=change-me
# Development only; defaults to False when unset
DEBUG=True

# Comma-separated. Add your LAN IP here to open the API from a phone.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from a browser (Expo web).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# PostgreSQL (matches docker-compose.yml)
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

# JWT
ACCESS_TOKEN_LIFETIME=15        # minutes
REFRESH_TOKEN_LIFETIME=1440     # days
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256

# E-mail (SMTP) - use your own account / app password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=you@example.com
